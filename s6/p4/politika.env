# s6/p4: backup politika kao kod. Brojevi su odluka (koliko podataka smijemo izgubiti, koliko dugo smijemo
# biti nedostupni), a skripta i raspored backupa moraju je ispuniti; test restore-a mjeri da li je ispunjava.
BAZA=prodavnica
ZADRZI=3              # lokalno se čuva zadnjih N backupa (retencija); starije briše backup.sh
RPO_CILJ_MIN=60       # Recovery Point Objective: najviše 60 min izgubljenih podataka -> backup barem svaki sat
RTO_CILJ_MIN=15       # Recovery Time Objective: baza mora ponovo raditi najviše 15 min nakon kvara
S3_BUCKET=ruo-backup  # kopija izvan servera (Garage iz s6/p2), ako radi: pravilo 3-2-1
S3_PREFIKS=postgres/
