# s5/p3: Postfix (MTA) za domenu ruo.lab, u namespace-u ruo5-mail (10.50.0.25).
# Odvojen je od eventualnog Postfixa na računaru: vlastiti config, red čekanja i podaci (postfix -c).
compatibility_level = 3.6
myhostname = mail.ruo.lab
mydomain = ruo.lab
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4
mydestination = localhost
mynetworks = 127.0.0.0/8
queue_directory = /var/spool/ruo5-postfix
data_directory = /var/lib/ruo5/postfix
maillog_file = /var/lib/ruo5/postfix/maillog
alias_maps =
alias_database =
biff = no
smtpd_banner = $myhostname ESMTP

# primanje pošte za @ruo.lab: postojeći sandučići, predaja Dovecotu preko LMTP-a
virtual_mailbox_domains = ruo.lab
virtual_mailbox_maps = texthash:/etc/ruo5/mail/postfix/sanducici
virtual_transport = lmtp:unix:private/dovecot-lmtp

# TLS (certifikat laba; u produkciji ACME, npr. Let's Encrypt)
smtpd_tls_cert_file = /etc/ruo5/mail/tls/mail.crt
smtpd_tls_key_file = /etc/ruo5/mail/tls/mail.key
smtpd_tls_security_level = may
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtp_tls_security_level = may

# prijava korisnika (SASL) ide preko Dovecota: jedna baza korisnika za slanje i čitanje
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no

# NIJE otvoreni relej: tuđe domene samo za prijavljene korisnike
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = reject_unknown_recipient_domain, permit
smtpd_helo_required = yes

# DKIM: OpenDKIM kao milter potpisuje odlaznu i provjerava dolaznu poštu
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = $smtpd_milters
milter_default_action = accept
